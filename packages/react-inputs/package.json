{
  "name": "@hotora/react-inputs",
  "version": "1.0.1",
  "description": "React adapter for Hotora Inputs — lightweight library for handling keyboard shortcuts, gestures and complex input sequences in React applications.",
  "author": "egorkk1211@gmail.com",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify --clean --external react"
  },
  "keywords": [
    "react",
    "hotkeys",
    "keyboard-shortcuts",
    "keybindings",
    "gestures",
    "touch-gestures",
    "input-manager",
    "event-handler",
    "react-hooks",
    "scoped-actions",
    "ux",
    "typescript"
  ],
  "homepage": "https://github.com/Egor-source/Hotora/tree/main/packages/react-inputs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Egor-source/Hotora.git",
    "directory": "packages/react-inputs"
  },
  "bugs": {
    "url": "https://github.com/Egor-source/Hotora/issues"
  },
  "peerDependencies": {
    "@hotora/inputs": ">=1.0.3",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
