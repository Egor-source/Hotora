{
  "name": "@hotora/inputs",
  "version": "1.0.0",
  "description": "Lightweight JavaScript and TypeScript library for handling keyboard shortcuts, gestures and complex sequences with customizable scoped actions.",
  "author": "egorkk1211@gmail.com",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "keywords": [
    "hotkeys",
    "keyboard-shortcuts",
    "key-combos",
    "key-sequences",
    "keybindings",
    "gestures",
    "touch-gestures",
    "multi-touch",
    "input-manager",
    "event-handler",
    "scoped-actions",
    "interaction",
    "ux",
    "typescript"
  ],
  "homepage": "https://github.com/Egor-source/Hotora/tree/main/packages/inputs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Egor-source/Hotora.git",
    "directory": "packages/inputs"
  },
  "bugs": {
    "url": "https://github.com/Egor-source/Hotora/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hotora/core": "^2.0.2"
  }
}
